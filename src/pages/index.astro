---
import Base from "../layouts/Base.astro";
import GuideLink from "../components/GuideLink.astro";
import site from "../../site.config.json";
import updates from "../data/updates.json";
import pals from "../data/palworld_pals.json";
import weapons from "../data/palworld_weapons.json";
import armor from "../data/palworld_armor.json";
const total = pals.length + weapons.length + armor.length;
const latest = updates[0];
const strongest = [...pals].sort((a, b) => (b.attack ?? 0) - (a.attack ?? 0))[0];
---

<Base title={`${site.siteName} - ${site.tagline}`} description={site.description}>
  <div class="hero">
    <h1>🐑 {site.siteName}</h1>
    <p class="muted hero-sub">
      Pal stats, drops and breeding ranks — plus weapon and armour numbers for every quality
      tier. The number you came for is always in the first screen. No wiki digging.
    </p>
    <div class="hero-badges">
      <span class="tag tag-live">● Live database · {total} pages</span>
      {latest && <span class="tag">Updated {latest.date}</span>}
    </div>
    <div class="search-wrap">
      <input id="site-search" type="search" placeholder="Search pals, weapons, armour… e.g. anubis" autocomplete="off" />
      <div id="search-results" hidden></div>
    </div>
    <p class="muted search-hint">{total} entries · tools pinned first · every stat on the first screen</p>
  </div>

  <h2>⚡ Only here — wiki can't do this</h2>
  <div class="grid grid-3">
    <GuideLink title="Breeding Calculator" desc={`Pick two Pals, get the child — all ${pals.filter((p: any) => p.breeding?.rank).length} breeding ranks + special combos built in.`} href="/breeding-calculator/" badge="Tool" />
    <GuideLink title="Strongest Pals" desc="Base attack and HP sorted — build your battle team from the top." href="/rankings/#pals" badge="Tool" />
    <GuideLink title="Best Work Pals" desc="Which Pal has Kindling 4, or the fastest Handiwork? Sorted by work level." href="/rankings/#work" badge="Tool" />
  </div>

  <h2>What changed</h2>
  <div class="card updates-card">
    {updates.slice(0, 5).map((u: any) => (
      <p class="update-line"><span class="dot">●</span> <a href={u.href}>{u.text}</a> <span class="muted">— {u.date}</span></p>
    ))}
    {updates.length === 0 && <p class="muted" style="margin:0">Freshly deployed — the feed fills in as Palworld patches land.</p>}
  </div>

  <h2>Browse the database</h2>
  <div class="grid grid-3">
    <GuideLink title="Pals" desc="Elements, base stats, work suitability, skills and drops for all {pals.length} Pals." href="/pals/" badge={`${pals.length} pals`} />
    <GuideLink title="Weapons" desc="Attack, durability and ammo for {weapons.length} weapons — Common through Legendary." href="/weapons/" badge={`${weapons.length} weapons`} />
    <GuideLink title="Armor" desc="Defense, health and equip effects for {armor.length} armour pieces and hats." href="/armor/" badge={`${armor.length} items`} />
    <GuideLink title="Rankings" desc="Strongest Pals, hardest hitters, best workers, top weapons and armour." href="/rankings/" badge="Rankings" />
    <GuideLink title="Breeding Calculator" desc="Breeding rank math + every special parent combination." href="/breeding-calculator/" badge="Tool" />
    <GuideLink title="All pages (A–Z)" desc="Jump straight to any Pal, weapon or armour from one search box." href="/search/" badge="Index" />
  </div>

  <h2>Why PalworldDB</h2>
  <p>
    Wikis give you one giant page per Pal with the stats buried mid-infobox. Here every page
    leads with the number — base HP/Attack/Defense in the first card, drop tables and the
    breeding rank up front — and the <a href="/breeding-calculator/">breeding calculator</a>
    answers "what do I pair with my Anubis?" in two clicks. Strongest right now:
    <a href={`/pals/${strongest?.slug}/`}>{strongest?.title}</a>.
  </p>
</Base>

<style>
  .hero { text-align: center; padding: 1rem 0 0.5rem; }
  .hero-sub { max-width: 660px; margin: 0 auto 0.9rem; }
  .hero-badges { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.1rem; }
  .tag-live { color: var(--good); border-color: var(--good); }
  .search-wrap { max-width: 560px; margin: 0 auto; position: relative; }
  #site-search { width: 100%; padding: 0.85rem 1.1rem; font-size: 1.05rem; border-radius: 12px; }
  #site-search:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
  #search-results {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    max-height: 340px; overflow-y: auto; text-align: left;
  }
  #search-results a {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.85rem; color: inherit; border-bottom: 1px solid var(--border);
  }
  #search-results a:last-child { border-bottom: none; }
  #search-results a:hover, #search-results a.active { background: var(--bg-soft); text-decoration: none; }
  #search-results img { width: 26px; height: 26px; object-fit: contain; flex: none; }
  #search-results .sk { margin-left: auto; color: var(--muted); font-size: 0.78rem; flex: none; }
  #search-results .tool-hit { color: var(--accent); font-weight: 700; }
  .search-hint { font-size: 0.82rem; margin: 0.5rem 0 0; }
  .updates-card { padding: 0.9rem 1.1rem; }
  .update-line { margin: 0.3rem 0; }
  .dot { color: var(--good); }
  @media (max-width: 640px) {
    .hero { text-align: left; }
    .hero-badges { justify-content: flex-start; }
  }
</style>

<script>
  type Entry = { t: string; u: string; k: string; i?: string };
  type Index = { tools: Entry[]; items: Entry[] };

  const box = document.getElementById("site-search") as HTMLInputElement;
  const panel = document.getElementById("search-results") as HTMLDivElement;
  let idx: Index | null = null;
  let sel = -1;
  let hits: Entry[] = [];

  fetch("/search-index.json")
    .then((r) => r.json())
    .then((d: Index) => { idx = d; });

  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch] as string));

  function render(q: string) {
    sel = -1; hits = [];
    if (!idx || !q.trim()) { panel.hidden = true; return; }
    const nq = q.trim().toLowerCase();
    const tools = idx.tools.filter((it) => it.t.toLowerCase().includes(nq));
    const scored = idx.items
      .map((it) => {
        const t = it.t.toLowerCase();
        const s = t.startsWith(nq) ? 0 : t.includes(nq) ? 1 : 9;
        return { it, s };
      })
      .filter((x) => x.s < 9)
      .sort((a, b) => a.s - b.s || a.it.t.length - b.it.t.length)
      .slice(0, 9)
      .map((x) => x.it);
    hits = [...tools, ...scored];
    if (hits.length === 0) {
      panel.innerHTML = `<a><span class="muted">No match for "${esc(q)}"</span></a>`;
      panel.hidden = false;
      return;
    }
    panel.innerHTML = hits
      .map((it, n) => {
        const icon = it.i ? `<img src="${it.i}" alt="" loading="lazy" />` : "";
        const kindCls = it.k === "Tool" ? " tool-hit" : "";
        const badge = it.k === "Tool" ? " ⭐" : "";
        return `<a href="${it.u}" data-n="${n}">${icon}<span class="${kindCls.trim()}">${esc(it.t)}${badge}</span><span class="sk">${esc(it.k)}</span></a>`;
      })
      .join("");
    panel.hidden = false;
  }

  function move(dir: number) {
    if (panel.hidden || hits.length === 0) return;
    sel = (sel + dir + hits.length) % hits.length;
    panel.querySelectorAll("a").forEach((a, n) => a.classList.toggle("active", n === sel));
  }

  box?.addEventListener("input", () => render(box.value));
  box?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Enter" && sel >= 0 && hits[sel]) { location.href = hits[sel].u; }
    else if (e.key === "Escape") { panel.hidden = true; }
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Node).closest(".search-wrap")) panel.hidden = true;
  });
</script>
